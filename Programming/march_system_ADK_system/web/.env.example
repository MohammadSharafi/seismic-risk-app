# March API base URL (no trailing slash).
# Local: http://localhost:8000
# Deployed: https://your-api-id.execute-api.us-east-1.amazonaws.com
VITE_MARCH_API_URL=http://localhost:8000

# AWS API Gateway stage - required if requests return 404 when using deployed URL.
# Common values: prod, dev, default. Or include stage in URL: ...amazonaws.com/prod
# VITE_MARCH_API_STAGE=prod

# Optional adapter mode:
# auto (default), march, command
VITE_API_MODE=march

# Legacy Command API URL (used only when VITE_MARCH_API_URL is unset)
# VITE_COMMAND_API_URL=http://localhost:8080

# Optional dedicated Patients API base URL (if different from VITE_MARCH_API_URL).
# VITE_PATIENTS_API_URL=https://your-patients-api.execute-api.us-east-1.amazonaws.com
#
# Optional comma-separated patient endpoint paths to try (relative or absolute URLs).
# VITE_PATIENTS_API_PATHS=/v1/patients?tenantId=default,/api/v1/patients?tenantId=default,/fhir/Patient?_count=200

# Optional API key for Command API. When the backend requires auth (command.api-key.required=true),
# set this so the UI sends X-API-Key on POST /v1/commands. Leave unset if backend does not require a key.
# VITE_COMMAND_API_KEY=your-api-key

# Optional local demo fallback only (format: mrn:name;mrn:name)
# VITE_MARCH_DEFAULT_PATIENTS=p-dev-001:Demo Patient 001;p1:Demo Patient P1
